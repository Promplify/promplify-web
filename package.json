{
  "name": "promplify",
  "version": "1.0.0",
  "description": "Open-source prompt management for creating, versioning, sharing, and integrating reusable AI workflows.",
  "private": true,
  "type": "module",
  "keywords": [
    "ai",
    "prompt",
    "prompt-engineering",
    "llm",
    "chatgpt",
    "claude",
    "prompt-management",
    "ai-tools"
  ],
  "homepage": "https://promplify.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Promplify/promplify-web.git"
  },
  "bugs": {
    "url": "https://github.com/Promplify/promplify-web/issues"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.16.0"
  },
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "postbuild": "node scripts/generate-static-route-html.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check": "npm run type-check && npm run lint && npm run test && npm run format:check",
    "clean": "rm -rf dist node_modules/.vite",
    "prepare": "npm run type-check"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-accordion": "^1.2.0",
